{
  "description": "Claude Ses voice integration hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\" 2>/dev/null && exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ses_hook.py\" || exec python \"${CLAUDE_PLUGIN_ROOT}/hooks/ses_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"\" 2>/dev/null && exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ses_hook.py\" || exec python \"${CLAUDE_PLUGIN_ROOT}/hooks/ses_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}